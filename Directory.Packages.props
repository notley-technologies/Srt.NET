<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
    <GlobalPackageReference Include="MinVer" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup Label="Library dependencies">
    <!--
      Versions that tests and tools resolve through transitive pinning. src/Srt.NET/Srt.NET.csproj publishes lower
      minimum versions with VersionOverride, and Dependabot ignores both packages, so update them together by hand.
    -->
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.14" />
    <PackageVersion Include="System.Memory" Version="4.6.3" />
  </ItemGroup>
  <ItemGroup Label="Library build tooling">
    <!-- Analyzer builds track Roslyn versions; 5.0.0 runs on every .NET 10 SDK feature band. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.0.0" />
    <PackageVersion Include="Microsoft.Sbom.Targets" Version="4.1.13" />
  </ItemGroup>
  <ItemGroup Label="Tests and tools">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CrashDump" Version="2.5.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.2" />
    <PackageVersion Include="FsCheck" Version="3.6.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
