<Project Sdk="Microsoft.NET.Sdk">
  <!-- Selects artifacts/runtimes/<rid>/native and the matching PlatformTarget; override with -p:NativeRuntimeIdentifier=<rid>. -->
  <Import Project="../../build/NativeRuntime.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- BenchmarkDotNet requires public, unsealed benchmark classes with instance methods. -->
    <NoWarn>$(NoWarn);CA1001;CA1822</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <ProjectReference Include="../../src/Srt.NET/Srt.NET.csproj" />
  </ItemGroup>
</Project>
