<?xml version="1.0" encoding="utf-8"?>
<!--
  Restores use nuget.org only, independent of machine or user NuGet configuration. Package source mapping sends
  every package ID to nuget.org, which prevents dependency confusion through extra feeds. Organizations that require
  a mirror can pass their own configuration file to restore instead of this one.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
