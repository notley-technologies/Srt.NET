#
# Exported symbols list for libsrt.dylib (macOS runtimes; ld -exported_symbols_list).
#
# Exports only the public SRT C API. Everything else, including the statically linked OpenSSL, stays private so the
# library cannot interpose on, or be interposed by, other copies of OpenSSL loaded into the same process.
# StageNative.cmake fails the build if any other symbol is exported.
_srt_*
