<Project>
  <!-- build/NativeRuntime.props (imported by Directory.Build.props) selects and copies the native library. -->
  <Target Name="CheckExampleNativeLibrary" BeforeTargets="CopyFilesToOutputDirectory">
    <Error Condition="'$(NativeRuntimeSupported)' != 'true'" Text="The examples do not include a native library for $(NativeRuntimeIdentifier). See examples/README.md for supported platforms." />
    <Error Condition="!Exists('$(NativeLibraryDirectory)$(NativeLibraryName)')" Text="Build libsrt for $(NativeRuntimeIdentifier) before running the examples. See examples/README.md. Expected: $(NativeLibraryDirectory)$(NativeLibraryName)" />
  </Target>
</Project>
