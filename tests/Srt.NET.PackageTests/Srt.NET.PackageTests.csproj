<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net10.0;net48</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <SrtPackageVersion Condition="'$(SrtPackageVersion)' == ''">0.1.0-dev</SrtPackageVersion>
    <UseTransitivePackage Condition="'$(UseTransitivePackage)' == ''">false</UseTransitivePackage>
    <DefineConstants Condition="'$(UseTransitivePackage)' == 'true'">$(DefineConstants);TRANSITIVE_PACKAGE</DefineConstants>
  </PropertyGroup>
  <!--
    Native AOT consumer (test-package with the aot option). Rooting Srt.NET makes the trimmer and ILC analyze every
    code path in the package, not only the paths this smoke test reaches, and any trim or AOT warning fails the publish.
  -->
  <PropertyGroup Condition="'$(SrtAotTest)' == 'true' And '$(TargetFramework)' == 'net10.0'">
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup Condition="'$(SrtAotTest)' == 'true' And '$(TargetFramework)' == 'net10.0'">
    <TrimmerRootAssembly Include="Srt.NET" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Bridge/**/*.cs" />
    <Compile Remove="CSharp73/**/*.cs" />
    <Compile Remove="PackageSmokeTest.cs" Condition="'$(UseTransitivePackage)' == 'true'" />
    <PackageReference Include="Srt.NET" Version="[$(SrtPackageVersion)]" Condition="'$(UseTransitivePackage)' != 'true'" />
    <PackageReference Include="Srt.NET.PackageTestBridge" Version="[$(SrtPackageVersion)]" Condition="'$(UseTransitivePackage)' == 'true'" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>
</Project>
