<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A .NET Framework application on that framework's default language version, C# 7.3, which predates init accessors
    and nullable reference types. The package must stay usable from it, so this project overrides the latest language
    version and nullable context that ../Directory.Build.props sets for the other consumer templates.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <!-- A warning in a down-level compile means part of the public surface is not usable from C# 7.3. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <SrtPackageVersion Condition="'$(SrtPackageVersion)' == ''">0.1.0-dev</SrtPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Srt.NET" Version="[$(SrtPackageVersion)]" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
