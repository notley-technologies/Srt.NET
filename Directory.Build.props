<Project>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>10.0</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup Label="Strong naming">
    <!--
      The key pair is committed on purpose, following Microsoft's open-source library guidance. Strong naming is
      assembly identity, not tamper protection. Never replace the key after the first release: that is a binary break.
      The absolute path also covers projects outside this tree that import these props, such as BenchmarkDotNet's
      generated projects.
    -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)Srt.NET.snk</AssemblyOriginatorKeyFile>
    <!-- Full public key of Srt.NET.snk (token 386853069135f01e). The SDK adds it to each InternalsVisibleTo item without Key metadata. -->
    <PublicKey></PublicKey>
  </PropertyGroup>

  <PropertyGroup Label="Versioning">
    <!-- MinVer derives the version from the nearest vX.Y.Z tag; untagged commits become prereleases. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
  </PropertyGroup>

  <PropertyGroup Label="Dependency auditing">
    <!-- Audit direct and transitive packages against nuget.org advisories instead of relying on SDK defaults. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <!-- Low (NU1901) and moderate (NU1902) advisories stay warnings; high (NU1903) and critical (NU1904) fail the build. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Packaging">
    <Authors>Noah Davis</Authors>
    <Copyright>Copyright (c) 2026 Noah Davis and Srt.NET contributors</Copyright>
    <PackageProjectUrl>https://github.com/notley-technologies/Srt.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/notley-technologies/Srt.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
